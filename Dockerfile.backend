# Build stage
FROM ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libssl-dev \
    libmysqlcppconn-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Strip out macOS Homebrew paths to compile on Linux
RUN sed -i '/\/opt\/homebrew/d' CMakeLists.txt

RUN mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release .. && \
    cmake --build .

# Runtime stage
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libmysqlcppconn-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/build/BankingAPIServer /app/BankingAPIServer

# Port will be configurable at runtime via environment variable
ENV SERVER_PORT=8080

EXPOSE 8080

ENTRYPOINT ["/app/BankingAPIServer"]
